{
  "expo": {
    "name": "Salefinder",
    "slug": "salefinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "salefinder",
    "splash": { "backgroundColor": "#0d0d0f" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.salefinder.app" },
    "android": { "adaptiveIcon": { "backgroundColor": "#0d0d0f" }, "package": "com.salefinder.app" },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
